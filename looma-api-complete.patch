+import { describe as steps, type FakeSupabase } from '../test/fakeSupabase'
+import {
+  attachReviewMedia, classifyReviewError, createReview, fetchAdminReviews, fetchOrderReview, fetchOrderToReview, fetchProductReviews,
+  fetchRecentDeliveredOrders, fetchReviewMedia, fetchReviewProducts, fetchReviewStats, fetchReviewedOrderIds, fetchStoreReviews, setReviewVisible,
+} from './reviews'
+
+vi.mock('../lib/supabase', async () => {
+  const { fakeSupabase } = await import('../test/fakeSupabase')
+  const fake = fakeSupabase()
+  return { supabase: fake.client, fake }
+})
+const fake = (supabaseModule as unknown as { fake: FakeSupabase }).fake
+beforeEach(() => fake.reset())
+
+describe('reading public reviews', () => {
+  it('reads the totals from the database', async () => {
+    fake.respondWith(() => ({ data: { count: 12, average: 4.6 } }))
+    await expect(fetchReviewStats()).resolves.toEqual({ count: 12, average: 4.6 })
+    expect(fake.calls[0].target).toBe('store_review_stats')
+  })
+
+  it('lists the 100 newest reviews, with no filter by default', async () => {
+    await fetchStoreReviews({ rating: null, withComments: false, sort: 'newest' })
+    expect(fake.calls[0].target).toBe('public_store_reviews')
+    expect(steps(fake.calls[0])).toBe('select(*) > limit(100) > order(created_at, {"ascending":false})')
+  })
+
+  it('narrows by stars and by "has a comment", and sorts best or worst first, newest within a rating', async () => {
+    await fetchStoreReviews({ rating: 2, withComments: true, sort: 'lowest' })
+    expect(steps(fake.calls[0])).toBe(
+      'select(*) > limit(100) > eq(rating, 2) > not(message, is, null) > order(rating, {"ascending":true}) > order(created_at, {"ascending":false})'
+    )
+    await fetchStoreReviews({ rating: null, withComments: false, sort: 'highest' })
+    expect(steps(fake.calls[1])).toContain('order(rating, {"ascending":false}) > order(created_at')
+  })
+
+  it('combines a product’s reviews with its average and count (numbers may arrive as text)', async () => {
+    fake.respondWith((call) =>
+      call.target === 'public_product_reviews' ? { data: [{ id: 'r1' }] } : { data: { count: '3', average: '4.33' } }
+    )
+    await expect(fetchProductReviews('p1')).resolves.toEqual({ reviews: [{ id: 'r1' }], count: 3, average: 4.33 })
+  })
+
+  it('shows zeros for a product nobody has reviewed', async () => {
+    fake.respondWith((call) => (call.target === 'public_product_reviews' ? { data: [] } : { data: null }))
+    await expect(fetchProductReviews('p1')).resolves.toEqual({ reviews: [], count: 0, average: 0 })
+  })
+
+  it('groups bought-products and media by review', async () => {
+    fake.respondWith((call) =>
+      call.target === 'public_review_products'
+        ? { data: [{ review_id: 'r1', product_id: 'p1', product_name: 'Tee' }, { review_id: 'r1', product_id: 'p2', product_name: 'Cap' }, { review_id: 'r2', product_id: 'p1', product_name: 'Tee' }] }
+        : { data: [{ id: 'm1', review_id: 'r1', kind: 'image', url: 'u' }] }
+    )
+    const products = await fetchReviewProducts(['r1', 'r2'])
+    expect(Object.keys(products)).toEqual(['r1', 'r2'])
+    expect(products.r1).toHaveLength(2)
+    await expect(fetchReviewMedia(['r1'])).resolves.toEqual({ r1: [{ id: 'm1', review_id: 'r1', kind: 'image', url: 'u' }] })
+  })
+
+  it('still shows reviews (without media) when the media can’t be read', async () => {
+    fake.respondWith(() => ({ error: { message: 'relation does not exist' } }))
+    await expect(fetchReviewMedia(['r1'])).resolves.toEqual({})
+  })
+})
+
+describe('a customer’s own reviews', () => {
+  it('lists the orders they already reviewed', async () => {
+    fake.respondWith(() => ({ data: [{ order_id: 'o1' }, { order_id: 'o2' }] }))
+    await expect(fetchReviewedOrderIds('u1')).resolves.toEqual(['o1', 'o2'])
+    expect(steps(fake.calls[0])).toBe('select(order_id) > eq(user_id, u1)')
+  })
+
+  it('finds delivered orders from the recent window, newest first, 10 at most', async () => {
+    vi.useFakeTimers()
+    vi.setSystemTime(new Date('2026-06-30T00:00:00.000Z'))
+    try {
+      await fetchRecentDeliveredOrders('u1', 45)
+    } finally {
+      vi.useRealTimers()
+    }
+    expect(steps(fake.calls[0])).toBe(
+      'select(id, order_number) > eq(user_id, u1) > eq(status, delivered) > gte(created_at, 2026-05-16T00:00:00.000Z) > order(created_at, {"ascending":false}) > limit(10)'
+    )
+  })
+
+  it('reads one order’s review and the order being reviewed', async () => {
+    await fetchOrderReview('o1')
+    await fetchOrderToReview('o1')
+    expect(fake.calls.map((c) => `${c.target}: ${steps(c)}`)).toEqual([
+      'store_reviews: select(id, rating) > eq(order_id, o1) > maybeSingle()',
+      'orders: select(id, order_number, status, order_items(name)) > eq(id, o1) > maybeSingle()',
+    ])
+  })
+})
+
+describe('writing a review', () => {
+  it('saves it and returns its id', async () => {
+    fake.respondWith(() => ({ data: { id: 'r9' } }))
+    await expect(createReview({ orderId: 'o1', userId: 'u1', rating: 5, itemCondition: 'great', delivery: null, message: 'Lovely' })).resolves.toBe('r9')
+    expect(steps(fake.calls[0])).toBe(
+      'insert({"order_id":"o1","user_id":"u1","rating":5,"item_condition":"great","delivery":null,"message":"Lovely"}) > select(id) > single()'
+    )
+  })
+
+  it('tells apart "already reviewed" and "not delivered yet" from the database’s codes', async () => {
+    expect(classifyReviewError({ code: '23505', message: 'duplicate' })).toBe('already_reviewed')
+    expect(classifyReviewError({ code: '42501', message: 'row-level security' })).toBe('not_delivered')
+    expect(classifyReviewError({ code: '08006' })).toBe('other')
+    expect(classifyReviewError(new Error('offline'))).toBe('other')
+  })
+
+  it('refuses with the database’s code intact', async () => {
+    fake.respondWith(() => ({ error: { message: 'duplicate key', code: '23505' } }))
+    await expect(createReview({ orderId: 'o1', userId: 'u1', rating: 5, itemCondition: null, delivery: null, message: null })).rejects.toMatchObject({ code: '23505' })
+  })
+
+  it('attaches uploaded files to the review for this customer', async () => {
+    await attachReviewMedia('r9', 'u1', [{ kind: 'image', url: 'a.jpg' }, { kind: 'video', url: 'b.mp4' }])
+    expect(fake.calls[0].target).toBe('review_media')
+    expect(fake.calls[0].steps[0][1][0]).toEqual([
+      { review_id: 'r9', user_id: 'u1', kind: 'image', url: 'a.jpg' },
+      { review_id: 'r9', user_id: 'u1', kind: 'video', url: 'b.mp4' },
+    ])
+  })
+})
+
+describe('moderation', () => {
+  it('reads the 200 latest reviews with the customer and media, hidden ones included', async () => {
+    await fetchAdminReviews()
+    expect(steps(fake.calls[0])).toBe('select(*, orders(order_number), profiles(full_name), review_media(id, kind, url)) > order(created_at, {"ascending":false}) > limit(200)')
+    expect(steps(fake.calls[0])).not.toContain('is_visible')
+  })
+
+  it('hides or shows a review', async () => {
+    await setReviewVisible('r1', false)
+    expect(steps(fake.calls[0])).toBe('update({"is_visible":false}) > eq(id, r1)')
+  })
+})
diff --git a/src/api/reviews.ts b/src/api/reviews.ts
new file mode 100644
index 0000000..5e4d2fb
--- /dev/null
+++ b/src/api/reviews.ts
@@ -0,0 +1,188 @@
+// Reviews: what customers read, what a customer writes about their order, and what the owner moderates.
+
+import { supabase } from '../lib/supabase'
+import type { ReviewMedia } from '../lib/reviewMedia'
+import type { PublicReview, ReviewFilters, ReviewProduct, ReviewStats } from '../lib/reviews'
+import { errorCode, run, unwrap } from './db'
+
+/* --------------------------------- reading --------------------------------- */
+
+// Totals for the summary and the product page link, counted in the database.
+export const fetchReviewStats = (): Promise<ReviewStats> => unwrap<ReviewStats>(supabase.rpc('store_review_stats'))
+
+// The most recent public reviews that match the filters (the first 100).
+export function fetchStoreReviews(filters: ReviewFilters): Promise<PublicReview[]> {
+  let query = supabase.from('public_store_reviews').select('*').limit(100)
+  if (filters.rating) query = query.eq('rating', filters.rating)
+  if (filters.withComments) query = query.not('message', 'is', null)
+
+  if (filters.sort === 'highest') query = query.order('rating', { ascending: false })
+  if (filters.sort === 'lowest') query = query.order('rating', { ascending: true })
+  query = query.order('created_at', { ascending: false })
+
+  return unwrap(query)
+}
+
+export interface ProductReviews {
+  reviews: PublicReview[]
+  count: number
+  average: number
+}
+
+// Reviews linked to one product (from customers who bought it), newest first, plus its average and count.
+export async function fetchProductReviews(productId: string): Promise<ProductReviews> {
+  const [reviews, stats] = await Promise.all([
+    unwrap<PublicReview[]>(
+      supabase.from('public_product_reviews').select('*').eq('product_id', productId).order('created_at', { ascending: false }).limit(20)
+    ),
+    unwrap<{ count: number | string; average: number | string } | null>(
+      supabase.from('product_review_stats').select('count, average').eq('product_id', productId).maybeSingle()
+    ),
+  ])
+  return { reviews, count: Number(stats?.count ?? 0), average: Number(stats?.average ?? 0) }
+}
+
+// The products each of these reviews is linked to, keyed by review id (for the "Bought:" line on review cards).
+export async function fetchReviewProducts(reviewIds: string[]): Promise<Record<string, ReviewProduct[]>> {
+  const rows = await unwrap<ReviewProduct[] | null>(
+    supabase.from('public_review_products').select('review_id, product_id, product_name').in('review_id', reviewIds)
+  )
+  const byReview: Record<string, ReviewProduct[]> = {}
+  for (const row of rows ?? []) (byReview[row.review_id] ??= []).push(row)
+  return byReview
+}
+
+// The photos and videos on these reviews, keyed by review id. If they can't be read, the reviews still show
+// (just without media), so this never throws.
+export async function fetchReviewMedia(reviewIds: string[]): Promise<Record<string, ReviewMedia[]>> {
+  const { data, error } = await supabase
+    .from('public_review_media')
+    .select('id, review_id, kind, url')
+    .in('review_id', reviewIds)
+    .order('created_at')
+  if (error) return {}
+  const byReview: Record<string, ReviewMedia[]> = {}
+  for (const row of (data ?? []) as ReviewMedia[]) (byReview[row.review_id] ??= []).push(row)
+  return byReview
+}
+
+/* ------------------------------ a customer's reviews ------------------------------ */
+
+// The ids of the orders this customer has already reviewed.
+export async function fetchReviewedOrderIds(userId: string): Promise<string[]> {
+  const rows = await unwrap<{ order_id: string }[] | null>(supabase.from('store_reviews').select('order_id').eq('user_id', userId))
+  return (rows ?? []).map((r) => r.order_id)
+}
+
+export interface PendingReviewOrder {
+  id: string
+  order_number: number
+}
+
+// Delivered orders placed in the last `days` days, newest first (the 10 latest). The "How was your order?"
+// prompt shows the ones not yet reviewed.
+export function fetchRecentDeliveredOrders(userId: string, days: number): Promise<PendingReviewOrder[]> {
+  const since = new Date(Date.now() - days * 86_400_000).toISOString()
+  return unwrap(
+    supabase
+      .from('orders')
+      .select('id, order_number')
+      .eq('user_id', userId)
+      .eq('status', 'delivered')
+      .gte('created_at', since)
+      .order('created_at', { ascending: false })
+      .limit(10)
+  )
+}
+
+// This customer's review of one order, or null if they haven't reviewed it.
+export const fetchOrderReview = (orderId: string): Promise<{ id: string; rating: number } | null> =>
+  unwrap(supabase.from('store_reviews').select('id, rating').eq('order_id', orderId).maybeSingle())
+
+export interface OrderToReview {
+  id: string
+  order_number: number
+  status: string
+  order_items: { name: string }[]
+}
+
+// The order a review is being written for (the database only lets you read your own).
+export const fetchOrderToReview = (orderId: string): Promise<OrderToReview | null> =>
+  unwrap(supabase.from('orders').select('id, order_number, status, order_items(name)').eq('id', orderId).maybeSingle())
+
+/* ------------------------------- writing a review ------------------------------- */
+
+export interface ReviewInput {
+  orderId: string
+  userId: string
+  rating: number
+  itemCondition: string | null
+  delivery: string | null
+  message: string | null
+}
+
+// Saves the review and returns its id. The database only allows one review per delivered order.
+export async function createReview(input: ReviewInput): Promise<string> {
+  const row = await unwrap<{ id: string }>(
+    supabase
+      .from('store_reviews')
+      .insert({
+        order_id: input.orderId,
+        user_id: input.userId,
+        rating: input.rating,
+        item_condition: input.itemCondition,
+        delivery: input.delivery,
+        message: input.message,
+      })
+      .select('id')
+      .single()
+  )
+  return row.id
+}
+
+// Why a review was refused:
+//   already_reviewed  this order already has one (database code 23505)
+//   not_delivered     reviews open once the order is delivered (code 42501)
+export type ReviewProblem = 'already_reviewed' | 'not_delivered' | 'other'
+
+export function classifyReviewError(err: unknown): ReviewProblem {
+  const code = errorCode(err)
+  if (code === '23505') return 'already_reviewed'
+  if (code === '42501') return 'not_delivered'
+  return 'other'
+}
+
+// Attaches uploaded photos and videos to a review.
+export const attachReviewMedia = (reviewId: string, userId: string, files: { kind: 'image' | 'video'; url: string }[]) =>
+  run(supabase.from('review_media').insert(files.map((f) => ({ review_id: reviewId, user_id: userId, kind: f.kind, url: f.url }))))
+
+/* ------------------------------- the owner's side ------------------------------- */
+
+export interface AdminReview {
+  id: string
+  rating: number
+  size_fit: string | null
+  comfort: string | null
+  delivery: string | null
+  item_condition: string | null
+  message: string | null
+  is_visible: boolean
+  created_at: string
+  orders: { order_number: number } | null
+  profiles: { full_name: string | null } | null
+  review_media: Pick<ReviewMedia, 'id' | 'kind' | 'url'>[] | null
+}
+
+// The 200 most recent reviews, hidden ones included.
+export const fetchAdminReviews = (): Promise<AdminReview[]> =>
+  unwrap(
+    supabase
+      .from('store_reviews')
+      .select('*, orders(order_number), profiles(full_name), review_media(id, kind, url)')
+      .order('created_at', { ascending: false })
+      .limit(200)
+  ) as unknown as Promise<AdminReview[]>
+
+// A hidden review disappears from the store and from the averages.
+export const setReviewVisible = (reviewId: string, visible: boolean) =>
+  run(supabase.from('store_reviews').update({ is_visible: visible }).eq('id', reviewId))
diff --git a/src/api/rider.test.ts b/src/api/rider.test.ts
